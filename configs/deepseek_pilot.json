{
  "backend": "deepseek",
  "data": "data/squad_article.json",
  "split": "dev",
  "sampling": "document_round_robin",
  "limit": 10,
  "encoding": "characters",
  "seed": 20261010,
  "repeats": 1,
  "model": "YOUR_AVAILABLE_MODEL_ID",
  "protocol": "chat",
  "thinking": "disabled",
  "answer_instruction": "Return only the shortest answer span that answers the question, using the language of the question. Do not add explanations. If the document does not provide the answer, return UNKNOWN.",
  "quality_metric": "exact_match",
  "allowed_quality_drop": 0,
  "max_tokens": 512,
  "max_calls": 40,
  "timeout": 120,
  "strategies": [
    {
      "name": "full",
      "method": "full",
      "ratio": 1
    },
    {
      "name": "head-0.5",
      "method": "head",
      "ratio": 0.5
    },
    {
      "name": "bm25-0.5",
      "method": "bm25",
      "ratio": 0.5
    },
    {
      "name": "neighbor1-0.5",
      "method": "bm25_neighbor",
      "ratio": 0.5,
      "radius": 1
    }
  ]
}
